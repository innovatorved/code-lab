      } else if (savedSession && savedSession.mode === 'repo' && savedSession.repo && hasSavedFilesForLab(savedSession.labId || '')) {
        repoInput.value = savedSession.repo;
        executeClone(savedSession.repo, { forceClone: false });
      } else if (savedSession && savedSession.mode === 'blank' && hasSavedFilesForLab(savedSession.labId || 'blank-workspace')) {
        openBlankWorkspace();
      }
    })();
  </script>
</body>
</html>
