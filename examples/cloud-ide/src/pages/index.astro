      });

      // Auto-clone if URL has ?repo=, open the demo if ?demo=, or restore last saved session
      const initialParams = new URLSearchParams(window.location.search);
      const urlRepo = initialParams.get('repo');
      const urlDemo = initialParams.get('demo');
      const savedSession = loadSessionMeta();
      if (urlDemo === 'react') {
