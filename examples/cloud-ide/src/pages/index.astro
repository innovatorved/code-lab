        window.history.replaceState({}, '', url.toString());
        saveSessionMeta({ mode: 'demo', demo: 'sql', labId });
        setTimeout(() => {
          if (ide && typeof ide.openFile === 'function') ide.openFile('query.sql');
          if (ide && typeof ide.runSql === 'function') ide.runSql('run');
        }, 120);
      }

      function openBlankWorkspace(opts = {}) {
        if (ideInstance && typeof ideInstance.openBlankWorkspace === 'function') {
          landingOverlay.classList.add('hidden');
          ideInstance.openBlankWorkspace({ ui: true, force: Boolean(opts && opts.force) }).then((newId) => {
            if (newId) {
              const url = new URL(window.location.href);
              url.searchParams.delete('repo');
              url.searchParams.delete('demo');
              url.searchParams.delete('blank');
              url.searchParams.delete('empty');
              window.history.replaceState({}, '', url.toString());
              saveSessionMeta({ mode: 'blank', labId: newId });
            }
          });
          return;
        }
        const labId = 'workspace-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6);
        const ide = ensureIde({ labId, blank: true, files: {} });
        landingOverlay.classList.add('hidden');
        const url = new URL(window.location.href);
        url.searchParams.delete('repo');
        url.searchParams.delete('demo');
        url.searchParams.delete('blank');
        url.searchParams.delete('empty');
        window.history.replaceState({}, '', url.toString());
        saveSessionMeta({ mode: 'blank', labId });
        if (ide) {
          setTimeout(() => {
            const ed = ide._editor || ide.editor;
            if (ed && typeof ed.layout === 'function') ed.layout();
          }, 50);
        }
      }

      openEmptyBtn.addEventListener('click', openBlankWorkspace);

      const landingCloseBtn = document.getElementById('landing-close-btn');
      if (landingCloseBtn) {
        landingCloseBtn.addEventListener('click', () => {
          if (!ideInstance) {
            openBlankWorkspace();
          } else {
            landingOverlay.classList.add('hidden');
          }
        });
      }

      landingOverlay.addEventListener('click', (e) => {
        const card = document.querySelector('.landing-card');
        if (card && !card.contains(e.target) && ideInstance) {
          landingOverlay.classList.add('hidden');
        }
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !landingOverlay.classList.contains('hidden') && ideInstance) {
          landingOverlay.classList.add('hidden');
        }
      });

      // Auto-clone if URL has ?repo=, open the demo if ?demo=, or restore last saved session
      const initialParams = new URLSearchParams(window.location.search);
      const urlRepo = initialParams.get('repo');
      const urlDemo = initialParams.get('demo');
      const urlBlank = initialParams.get('blank') === '1' || initialParams.get('blank') === 'true' || initialParams.get('empty') === '1';
      const urlWorkspace = initialParams.get('workspace') || initialParams.get('labId');
      const savedSession = loadSessionMeta();
      if (urlBlank) {
        openBlankWorkspace({ force: true });
      } else if (urlWorkspace) {
        const isBlank = urlWorkspace.startsWith('workspace-') || urlWorkspace.startsWith('blank-');
        const ide = ensureIde({ labId: urlWorkspace, blank: isBlank, files: {} });
        landingOverlay.classList.add('hidden');
        if (ide) {
          setTimeout(() => {
            const ed = ide._editor || ide.editor;
            if (ed && typeof ed.layout === 'function') ed.layout();
          }, 50);
        }
      } else if (urlDemo === 'react') {
        openFrameworkDemo({ forceReset: false });
      } else if (urlDemo === 'sql') {
        openSqlDemo({ forceReset: false });
      } else if (urlDemo === 'sd-cluster' || urlDemo === 'sd-shortener') {
        openSystemDesignDemo(urlDemo, { forceReset: false });
      } else if (urlDemo === 'cpp' || urlDemo === 'python') {
        openLanguageDemo(urlDemo, { forceReset: false });
      } else if (urlRepo) {
        repoInput.value = urlRepo;
        executeClone(urlRepo, { forceClone: false });
      } else if (savedSession && savedSession.mode === 'demo' && savedSession.demo === 'react') {
        openFrameworkDemo({ forceReset: false });
      } else if (savedSession && savedSession.mode === 'demo' && savedSession.demo === 'sql') {
        openSqlDemo({ forceReset: false });
      } else if (savedSession && savedSession.mode === 'demo' && (savedSession.demo === 'sd-cluster' || savedSession.demo === 'sd-shortener')) {
        openSystemDesignDemo(savedSession.demo, { forceReset: false });
      } else if (savedSession && savedSession.mode === 'demo' && (savedSession.demo === 'cpp' || savedSession.demo === 'python')) {
        openLanguageDemo(savedSession.demo, { forceReset: false });
      } else if (savedSession && savedSession.mode === 'repo' && savedSession.repo && hasSavedFilesForLab(savedSession.labId || '')) {
        repoInput.value = savedSession.repo;
        executeClone(savedSession.repo, { forceClone: false });
      } else if (savedSession && savedSession.mode === 'blank' && (savedSession.labId || hasSavedFilesForLab(savedSession.labId || 'blank-workspace'))) {
        const targetLabId = savedSession.labId || 'blank-workspace';
        const ide = ensureIde({ labId: targetLabId, blank: true, files: {} });
        landingOverlay.classList.add('hidden');
        if (ide) {
          setTimeout(() => {
            const ed = ide._editor || ide.editor;
            if (ed && typeof ed.layout === 'function') ed.layout();
          }, 50);
        }
      }
    })();
  </script>
</body>
</html>
