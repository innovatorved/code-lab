---
// code-lab Cloud IDE — System Design In-Depth Aesthetic Alignment
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>code-lab — Browser IDE & GitHub Repository Explorer</title>
  <meta name="description" content="Clone and run any public GitHub repository directly in your browser with zero server setup. Powered by code-lab.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <link rel="stylesheet" href="/dist/code-lab.css">
  <link rel="stylesheet" href="/dist/code-lab-sql.css">
  <script is:inline src="/dist/code-lab.js"></script>

  <style is:global>
    @font-face {
      font-family: "Geist";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/geist-latin.woff2") format("woff2");
    }
    @font-face {
      font-family: "Geist Mono";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/geist-mono-latin.woff2") format("woff2");
    }

    /* ═══════════════════════════════════════════════════════════════
       Ved Gupta Unified Design System — Charcoal Ink & Warm Paper
       ═══════════════════════════════════════════════════════════════ */
    :root {
      color-scheme: light dark;
    }

    :root,
    [data-theme="dark"] {
      --bg: #0f0f10;
      --bg-alt: #141415;
      --sidebar-bg: #141415;
      --surface: #18181a;
      --surface-hover: #1f1f22;
      --surface-active: #28282b;
      --border: #27272a;
      --border-strong: #3a3a3e;
      --border-focus: #a1a1aa;
      --divider: #202023;

      --fg: #f4f4f5;
      --fg-prose: #e4e4e7;
      --fg-muted: #a1a1aa;
      --fg-faint: #8e8e97;

      --accent: #f4f4f5;
      --accent-hover: #ffffff;
      --accent-muted: rgba(244, 244, 245, 0.08);
      --accent-border: rgba(244, 244, 245, 0.22);
      --accent-fg: #0f0f10;

      --success: #34d399;
      --success-muted: rgba(16, 185, 129, 0.12);
      --warning: #fbbf24;
      --warning-muted: rgba(245, 158, 11, 0.12);
      --error: #f87171;
      --error-muted: rgba(239, 68, 68, 0.12);
      --info: #e4e4e7;
      --info-muted: rgba(244, 244, 245, 0.1);

      --r-sm: 4px;
      --r-md: 6px;
      --r-lg: 8px;
      --r-xl: 10px;
      --r-full: 999px;

      --font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace;
      --text-2xs: 0.6875rem;
      --text-xs: 0.75rem;
      --text-sm: 0.8125rem;
      --text-base: 0.875rem;
      --text-lg: 1.0625rem;
      --text-xl: 1.5rem;
      --card-shadow: 0 18px 44px rgba(0, 0, 0, 0.48);
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #f7f7f5;
      --bg-alt: #f1f1ee;
      --sidebar-bg: #f7f7f5;
      --surface: #ffffff;
      --surface-hover: #f5f5f2;
      --surface-active: #ecebe7;
      --border: #e6e4df;
      --border-strong: #d3d0c9;
      --border-focus: #3f3f46;
      --divider: #e9e7e2;

      --fg: #18181b;
      --fg-prose: #27272a;
      --fg-muted: #52525b;
      --fg-faint: #6e6a64;

      --accent: #18181b;
      --accent-hover: #27272a;
      --accent-muted: rgba(24, 24, 27, 0.06);
      --accent-border: rgba(24, 24, 27, 0.18);
      --accent-fg: #ffffff;

      --success: #067647;
      --success-muted: rgba(6, 118, 71, 0.09);
      --warning: #b54708;
      --warning-muted: rgba(181, 71, 8, 0.09);
      --error: #b42318;
      --error-muted: rgba(180, 35, 24, 0.09);
      --info: #18181b;
      --info-muted: rgba(24, 24, 27, 0.08);
      --card-shadow: 0 14px 36px rgba(24, 24, 27, 0.08);

      color-scheme: light;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-sans);
      height: 100dvh;
      width: 100vw;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .visually-hidden:where(:not(:focus-within, :active)) {
      position: absolute !important;
      clip-path: inset(50%) !important;
      overflow: hidden !important;
      width: 1px !important;
      height: 1px !important;
      margin: -1px !important;
      padding: 0 !important;
      border: 0 !important;
      white-space: nowrap !important;
    }

    :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
      outline: 1px solid var(--border-focus);
      outline-offset: -1px;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 2px var(--success-muted);
    }

    /* ═══════════════════════════════════════════════════════════════
       Main Viewport & Landing Screen
       ═══════════════════════════════════════════════════════════════ */
    .app-main {
      flex: 1;
      position: relative;
      display: flex;
      height: 100dvh;
      width: 100vw;
    }

    .landing-overlay {
      position: fixed;
      inset: 0;
      background: var(--bg);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
      overflow-y: auto;
    }

    .landing-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      display: none !important;
    }

    .landing-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      padding: 32px;
      box-shadow: var(--card-shadow);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .landing-close-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 28px;
      height: 28px;
      border-radius: var(--r-sm);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--fg-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-base);
      line-height: 1;
      transition: all 120ms ease;
    }

    .landing-close-btn:hover {
      color: var(--fg);
      background: var(--surface-hover);
      border-color: var(--border-strong);
    }

    .landing-header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 28px;
    }

    .landing-title {
      font-size: var(--text-xl);
      font-weight: 600;
      letter-spacing: -0.035em;
      line-height: 1.2;
      color: var(--fg);
    }

    .landing-desc {
      font-size: var(--text-sm);
      color: var(--fg-muted);
      line-height: 1.6;
    }

    .repo-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .input-row {
      display: flex;
      gap: 8px;
    }

    .repo-input-wrapper {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .repo-input {
      width: 100%;
      height: 40px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 0 12px;
      font-size: 13px;
      font-family: var(--font-mono);
      color: var(--fg);
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .repo-input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 1px var(--border-focus);
    }

    .repo-input:focus:not(:focus-visible) {
      outline: none;
    }

    .submit-btn {
      height: 40px;
      padding: 0 16px;
      background: var(--accent);
      color: var(--accent-fg);
      border: 1px solid var(--accent);
      border-radius: var(--r-md);
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font-sans);
      letter-spacing: -0.01em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 140ms ease, opacity 140ms ease;
      white-space: nowrap;
    }

    .submit-btn:hover:not(:disabled) {
      background: var(--accent-hover);
    }

    .submit-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Preset Quick-Clone Chips */
    .chip-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .chip-label {
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--fg-faint);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .chip-item {
      font-size: 11px;
      font-family: var(--font-mono);
      padding: 3px 8px;
      background: var(--surface-hover);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
      user-select: none;
    }

    .chip-item:hover {
      color: var(--fg);
      background: var(--surface-active);
      border-color: var(--border-strong);
    }

    /* Streaming Clone Progress Box */
    .progress-box {
      display: none;
      flex-direction: column;
      gap: 6px;
      padding: 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.45;
      max-height: 160px;
      overflow-y: auto;
    }

    .progress-box.active {
      display: flex;
    }

    .progress-line {
      display: flex;
      align-items: baseline;
      gap: 8px;
      color: var(--fg-muted);
    }

    .progress-line .time {
      color: var(--fg-faint);
      font-size: 10px;
      flex-shrink: 0;
    }

    .progress-line.connecting { color: var(--info); }
    .progress-line.metadata { color: var(--fg); }
    .progress-line.downloading { color: var(--fg-muted); }
    .progress-line.mounting { color: var(--warning); }
    .progress-line.ready { color: var(--success); font-weight: 500; }
    .progress-line.error { color: var(--error); font-weight: 500; }

    .alt-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: var(--text-xs);
      padding-top: 8px;
      border-top: 1px solid var(--divider);
    }

    .alt-meta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--fg-faint);
      font-size: var(--text-2xs);
      font-family: var(--font-mono);
    }

    .alt-link {
      font: inherit;
      background: transparent;
      border: none;
      padding: 2px 4px;
      border-radius: var(--r-sm);
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 120ms ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .alt-link:hover {
      color: var(--fg);
    }

    /* Fullscreen IDE Mount */
    #codelab-mount {
      width: 100%;
      height: 100%;
      flex: 1;
    }

    #codelab-mount .codelab {
      height: 100%;
      max-height: none !important;
      border-radius: 0;
      border: none;
    }
  </style>
</head>
<body>

  <!-- App Main Workspace -->
  <main class="app-main">
    <!-- Initial Landing View: Repo Input & Live Progress Box -->
    <div class="landing-overlay" id="landing-overlay">
      <div class="landing-card">
        <button type="button" class="landing-close-btn" id="landing-close-btn" aria-label="Close" title="Close (Esc)">✕</button>
        <div class="landing-header">
          <h1 class="landing-title">Clone &amp; Explore GitHub Repositories</h1>
          <p class="landing-desc">
            Run any public GitHub repository or interactive sandbox directly in your browser — Node.js v22, Bun, TypeScript, SQL Studio, Python 3.12, and C++20 WASI with zero server setup.
          </p>
        </div>

        <form class="repo-form" id="landing-form">
          <div class="input-row">
            <div class="repo-input-wrapper">
              <label for="landing-repo-input" class="visually-hidden">Public GitHub repository</label>
              <input
                type="text"
                id="landing-repo-input"
                class="repo-input"
                placeholder="mdn/todo-react or github.com/owner/repo"
                spellcheck="false"
                autocomplete="off"
              />
            </div>
            <button type="submit" class="submit-btn" id="landing-clone-btn">
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Clone &amp; Open</span>
            </button>
          </div>

          <!-- Interactive Sandboxes -->
          <div class="chip-container">
            <div class="chip-label">Interactive Sandboxes</div>
            <div class="chip-list">
              <button type="button" class="chip-item chip-item--demo" data-demo="sd-cluster">⚡ L7 Load Balancer &amp; Chaos Cluster</button>
              <button type="button" class="chip-item chip-item--demo" data-demo="sd-shortener">🔗 URL Shortener &middot; SQLite + Singleflight</button>
              <button type="button" class="chip-item chip-item--demo" data-demo="sql">🗄 SQL Studio &middot; Guided Query Lab</button>
              <button type="button" class="chip-item chip-item--demo" data-demo="react">⚛ React App &middot; live preview</button>
              <button type="button" class="chip-item chip-item--demo" data-demo="cpp">⚙ C++20 WASI &middot; DSA Benchmark</button>
              <button type="button" class="chip-item chip-item--demo" data-demo="python">🐍 Python 3.12 &middot; Async &amp; VFS</button>
            </div>
          </div>

          <!-- Sample GitHub Repositories -->
          <div class="chip-container">
            <div class="chip-label">Sample GitHub Repositories</div>
            <div class="chip-list">
              <button type="button" class="chip-item" data-repo="mdn/todo-react">mdn/todo-react</button>
              <button type="button" class="chip-item" data-repo="ahfarmer/calculator">ahfarmer/calculator</button>
              <button type="button" class="chip-item" data-repo="gabrielecirulli/2048">gabrielecirulli/2048</button>
              <button type="button" class="chip-item" data-repo="innovatorved/piano-web">innovatorved/piano-web</button>
            </div>
          </div>

          <!-- Streaming Logs Box -->
          <div class="progress-box" id="progress-box"></div>

          <div class="alt-actions">
            <button type="button" class="alt-link" id="open-empty-btn">Open blank workspace &rarr;</button>
            <span class="alt-meta"><span class="status-dot" aria-hidden="true"></span><span id="version-status-label">v0.7.1</span> &middot; client-side runtime &middot; zero auth</span>
          </div>
        </form>
      </div>
    </div>

    <!-- Fullscreen CodeLab Workbench Mount -->
    <div id="codelab-mount"></div>
  </main>

  <script is:inline>
    (function () {
      const mountEl = document.getElementById('codelab-mount');
      const landingOverlay = document.getElementById('landing-overlay');
      const landingForm = document.getElementById('landing-form');
      const repoInput = document.getElementById('landing-repo-input');
      const cloneBtn = document.getElementById('landing-clone-btn');
      const progressBox = document.getElementById('progress-box');
      const openEmptyBtn = document.getElementById('open-empty-btn');
      const chipItems = document.querySelectorAll('.chip-item');
      const versionStatusLabel = document.getElementById('version-status-label');
      if (versionStatusLabel && window.CodeLab && window.CodeLab.version) {
        versionStatusLabel.textContent = `v${window.CodeLab.version}`;
      }

      let ideInstance = null;

      function logProgress(phase, message) {
        progressBox.classList.add('active');
        const line = document.createElement('div');
        line.className = 'progress-line ' + (phase || '');
        const time = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const timeSpan = document.createElement('span');
        timeSpan.className = 'time';
        timeSpan.textContent = `[${time}]`;
        const msgSpan = document.createElement('span');
        msgSpan.textContent = String(message || '');
        line.appendChild(timeSpan);
        line.appendChild(msgSpan);
        progressBox.appendChild(line);
        progressBox.scrollTop = progressBox.scrollHeight;
      }

      const SESSION_STORAGE_KEY = 'codelab:cloud-ide:session';

      function saveSessionMeta(meta) {
        try {
          localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({ ...meta, updatedAt: Date.now() }));
        } catch (_) {}
      }

      function loadSessionMeta() {
        try {
          const raw = localStorage.getItem(SESSION_STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_) {
          return null;
        }
      }

      function hasSavedFilesForLab(labId) {
        try {
          const raw = localStorage.getItem('sd-codelab-v1:' + labId)
            || localStorage.getItem('sd_codelab_' + labId)
            || localStorage.getItem('codelab_' + labId);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          if (parsed && parsed.files && Object.keys(parsed.files).length > 0) return true;
          if (parsed && parsed.customFiles && typeof parsed.customFiles === 'object') {
            for (const slot of Object.values(parsed.customFiles)) {
              if (slot && typeof slot === 'object' && Object.keys(slot).length > 0) return true;
            }
          }
          return Boolean(parsed && (parsed.isBlankBase || (parsed.hasSnapshot && Object.keys(parsed.hasSnapshot).length > 0)));
        } catch (_) {
          return false;
        }
      }

      function ensureIde(options = {}) {
        if (ideInstance && (!options.labId || ideInstance.labId === options.labId)) {
          return ideInstance;
        }
        const targetLabId = options.labId || 'cloud-ide';
        if (ideInstance && ideInstance.labId !== targetLabId) {
          if (typeof ideInstance.saveWorkspace === 'function') {
            try { ideInstance.saveWorkspace(); } catch (_) {}
          }
          if (typeof ideInstance.destroy === 'function') ideInstance.destroy();
          mountEl.innerHTML = '';
          ideInstance = null;
        }
        if (!ideInstance && window.CodeLab) {
          const bundledExts = window.CodeLab.extensions || {};
          const defaultExtensions = [
            bundledExts.typescript,
            bundledExts.python,
            bundledExts.cpp
          ].filter(Boolean);
          const isBlank = Boolean(options.blank || targetLabId.startsWith('workspace-') || targetLabId.startsWith('blank-'));
          const defaultWelcomeTemplates = [
            { id: 'react', title: 'React 19 + TypeScript', description: 'Interactive counter & state app', badge: 'JSX / TS' },
            { id: 'sql', title: 'SQL Studio (SQLite WASM)', description: 'Schema browser, EXPLAIN plan & Guided Lab', badge: 'SQL' },
            { id: 'python', title: 'Python 3 Data & Algorithms', description: 'Pyodide WASM + browser stdin/stdout', badge: 'PY' },
            { id: 'cpp', title: 'C++20 Systems Playground', description: 'Clang/WASI compiler & binary execution', badge: 'C++20' },
            { id: 'sd-cluster', title: 'Distributed Cluster Lab', description: 'Consistent hashing & node failover', badge: 'SYS' },
            { id: 'sd-shortener', title: 'URL Shortener Architecture', description: 'Base62 encoding & rate-limiting', badge: 'SYS' }
          ];
          ideInstance = window.CodeLab.mount(mountEl, {
            labId: targetLabId,
            title: options.title || 'code-lab',
            fullbleed: true,
            theme: document.documentElement.getAttribute('data-theme') || 'dark',
            extensions: options.extensions || defaultExtensions,
            welcomeTemplates: options.welcomeTemplates || defaultWelcomeTemplates,
            onSelectWelcomeTemplate: options.onSelectWelcomeTemplate || ((demoId) => {
              if (demoId === 'react') openFrameworkDemo({ forceReset: false });
              else if (demoId === 'sql') openSqlDemo({ forceReset: false });
              else if (demoId === 'sd-cluster' || demoId === 'sd-shortener') openSystemDesignDemo(demoId, { forceReset: false });
              else if (demoId === 'cpp' || demoId === 'python') openLanguageDemo(demoId, { forceReset: false });
            }),
            files: options.files || (isBlank ? {} : {
              'README.md': '# Welcome to code-lab v0.7.1\n\n- **Settings UI & Workspace JSON**: Press `Cmd+,` / `Ctrl+,` (or click **Settings** in the top bar) to configure editor, terminal, and SQL dialect preferences, backed by `.codelab/settings.json`.\n- **SQL Studio & Guided Labs**: Open the **SQL Studio** demo from the home screen or run `sqlite3` directly in the POSIX terminal.\n- **Multi-Runtime Terminal**: Click `+` in the terminal drawer header for multiple sessions, or run `git clone <owner/repo>`, `node`, `bun`, `python3`, or `clang++`.\n',
              '.codelab/settings.json': '{\n  "sql.defaultDialect": "sqlite"\n}\n'
            }),
            entry: isBlank ? null : (options.entry || 'demo.js'),
            ...options
          });
        }
        // Exposed for the demo console and for end-to-end tests that need the
        // live instance.
        window.__codelabIde = ideInstance;
        return ideInstance;
      }

      async function executeClone(targetRepo, options = {}) {
        if (!targetRepo) return;
        const cleanRepoName = targetRepo.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase();
        const labId = 'repo-' + cleanRepoName;
        if (!options.forceClone && hasSavedFilesForLab(labId)) {
          const ide = ensureIde({ labId });
          saveSessionMeta({ mode: 'repo', repo: targetRepo, labId });
          landingOverlay.classList.add('hidden');
          if (ide) {
            setTimeout(() => {
              const ed = ide._editor || ide.editor;
              if (ed && typeof ed.layout === 'function') ed.layout();
            }, 60);
          }
          return;
        }

        let targetLabId = labId;
        if (options.forceClone && (hasSavedFilesForLab(labId) || (ideInstance && ideInstance._needsWorkspaceConfirm()))) {
          const ide = ensureIde();
          if (ide && typeof ide._showWorkspaceConfirmModal === 'function') {
            landingOverlay.classList.add('hidden');
            const choice = await ide._showWorkspaceConfirmModal({
              title: 'Clone Repository Into Workspace',
              message: `Your current workspace contains files or unsaved edits. Clone "${targetRepo}" into a new isolated workspace or replace the current workspace?`,
              isolateLabel: 'New Isolated Workspace',
              replaceLabel: 'Replace Current Workspace'
            });
            if (choice === 'cancel') {
              return;
            }
            if (choice === 'isolated') {
              targetLabId = `${labId}-${Date.now().toString(36)}`;
            }
          }
        }

        cloneBtn.disabled = true;
        progressBox.innerHTML = '';
        logProgress('connecting', `Connecting to GitHub API for ${targetRepo}...`);

        try {
          const ide = ensureIde({ labId: targetLabId });
          if (!ide) {
            throw new Error('CodeLab SDK failed to initialize');
          }

          logProgress('metadata', 'Fetching repository tree and metadata...');

          const cloneFn = (typeof ide.cloneRepo === 'function') 
            ? ide.cloneRepo.bind(ide) 
            : (window.CodeLab && typeof window.CodeLab.cloneRepo === 'function')
              ? ((r, opts) => window.CodeLab.cloneRepo(r, ide.shell ? ide.shell.vfs : null, opts))
              : null;

          if (!cloneFn) {
            throw new Error('cloneRepo is not supported in this build');
          }

          logProgress('downloading', 'Downloading source files into virtual filesystem...');

          const result = await cloneFn(targetRepo, {
            intoRoot: true,
            onProgress: (evt) => {
              if (evt && evt.message) {
                logProgress(evt.phase || 'downloading', evt.message);
              }
            }
          });

          const count = result.filesWritten || (result.files && Object.keys(result.files).length) || 0;
          logProgress('mounting', `Synchronizing ${count} files into Monaco editor & explorer...`);
          logProgress('ready', `✓ Cloned ${result.owner || ''}/${result.repo || targetRepo}@${result.branch || 'main'} successfully!`);

          // Update URL without full reload
          const url = new URL(window.location.href);
          url.searchParams.delete('demo');
          url.searchParams.set('repo', targetRepo);
          window.history.replaceState({}, '', url.toString());
          saveSessionMeta({ mode: 'repo', repo: targetRepo, labId: targetLabId });

          // Transition to full IDE (do not auto-run/preview cloned repos; let the user run explicitly)
          setTimeout(() => {
            landingOverlay.classList.add('hidden');
            if (ide) {
              const ed = ide._editor || ide.editor;
              if (ed && typeof ed.layout === 'function') ed.layout();
            }
          }, 350);

