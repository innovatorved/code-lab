---
// code-lab Cloud IDE — Astro Page
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>code-lab — Browser IDE & GitHub Repository Explorer</title>
  <meta name="description" content="Clone and run any public GitHub repository directly in your browser with zero server setup. Powered by code-lab.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/dist/code-lab.css">
  <script is:inline src="/dist/code-lab.js"></script>

  <style>
    :root {
      --bg: #09090b;
      --card-bg: #121215;
      --border: #27272a;
      --fg: #fafafa;
      --fg-muted: #a1a1aa;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --surface: #18181b;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    [data-theme="light"] {
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      --fg: #0f172a;
      --fg-muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --surface: #f1f5f9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-sans);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Top Navigation Header */
    .app-header {
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
      z-index: 10;
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: -0.02em;
      cursor: pointer;
    }

    .app-logo {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      font-family: var(--font-mono);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--fg-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
      text-decoration: none;
    }

    .icon-btn:hover {
      background: var(--card-bg);
      color: var(--fg);
      border-color: var(--fg-muted);
    }

    .clone-new-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
      padding: 0 12px;
      height: 30px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--fg);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .clone-new-btn:hover {
      border-color: var(--primary);
    }

    /* Main Container */
    .app-main {
      flex: 1;
      position: relative;
      display: flex;
      height: calc(100vh - 48px);
    }

    /* Landing Overlay Screen */
    .landing-overlay {
      position: absolute;
      inset: 0;
      background: var(--bg);
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .landing-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .landing-card {
      width: 100%;
      max-width: 580px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .landing-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .landing-desc {
      font-size: 14px;
      color: var(--fg-muted);
      line-height: 1.5;
    }

    .repo-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .input-row {
      display: flex;
      gap: 8px;
    }

    .repo-input {
      flex: 1;
      height: 42px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0 14px;
      font-size: 14px;
      font-family: var(--font-mono);
      color: var(--fg);
      outline: none;
      transition: border-color 0.15s ease;
    }

    .repo-input:focus {
      border-color: var(--primary);
    }

    .submit-btn {
      height: 42px;
      padding: 0 18px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.15s ease;
      white-space: nowrap;
    }

    .submit-btn:hover:not(:disabled) {
      background: var(--primary-hover);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .alt-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }

    .alt-link {
      color: var(--fg-muted);
      text-decoration: underline;
      cursor: pointer;
      transition: color 0.15s ease;
    }

    .alt-link:hover {
      color: var(--fg);
    }

    /* Streaming Clone Progress Box */
    .progress-box {
      display: none;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
      padding: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 12px;
      max-height: 180px;
      overflow-y: auto;
    }

    .progress-box.active {
      display: flex;
    }

    .progress-line {
      display: flex;
      gap: 8px;
      color: var(--fg-muted);
    }

    .progress-line.connecting { color: #60a5fa; }
    .progress-line.metadata { color: #818cf8; }
    .progress-line.downloading { color: #38bdf8; }
    .progress-line.mounting { color: #f59e0b; }
    .progress-line.ready { color: #10b981; font-weight: 600; }
    .progress-line.error { color: #ef4444; }

    /* Fullscreen IDE Mount */
    #codelab-mount {
      width: 100%;
      height: 100%;
      flex: 1;
    }

    #codelab-mount .codelab {
      height: 100%;
      border-radius: 0;
      border: none;
    }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <header class="app-header">
    <div class="app-brand" id="brand-home-btn" title="code-lab">
      <div class="app-logo">&lt;/&gt;</div>
      <span>code-lab</span>
    </div>

    <div class="header-actions">
      <button type="button" class="clone-new-btn" id="open-clone-modal-btn" title="Clone another repository">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Clone Repo</span>
      </button>

      <!-- Theme Button: Icon-Only (Sun / Moon) -->
      <button type="button" class="icon-btn" id="theme-btn" title="Toggle Theme" aria-label="Toggle Theme">
        <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>

      <!-- Docs Wiki Link -->
      <a class="icon-btn" href="https://github.com/innovatorved/code-lab/wiki" target="_blank" rel="noopener noreferrer" title="Documentation Wiki" aria-label="Wiki">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </a>

      <!-- GitHub Repository Link -->
      <a class="icon-btn" href="https://github.com/innovatorved/code-lab" target="_blank" rel="noopener noreferrer" title="GitHub Repository" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </a>
    </div>
  </header>

  <!-- App Main Workspace -->
  <main class="app-main">
    <!-- Initial Landing View: Repo Input & Live Progress Box -->
    <div class="landing-overlay" id="landing-overlay">
      <div class="landing-card">
        <div class="landing-title">
          <div class="app-logo">&lt;/&gt;</div>
          <span>code-lab</span>
        </div>
        <p class="landing-desc">
          Enter any public GitHub repository to clone and explore it directly in your browser. Powered by Node.js v22 and Bun v1.1 virtual Web Worker runtime with zero server dependencies.
        </p>

        <form class="repo-form" id="landing-form">
          <div class="input-row">
            <input
              type="text"
              id="landing-repo-input"
              class="repo-input"
              placeholder="owner/repo or https://github.com/owner/repo"
              value="innovatorved/code-lab"
              spellcheck="false"
              autocomplete="off"
            />
            <button type="submit" class="submit-btn" id="landing-clone-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Clone &amp; Open</span>
            </button>
          </div>

          <!-- Streaming Logs Box -->
          <div class="progress-box" id="progress-box"></div>

          <div class="alt-actions">
            <span class="alt-link" id="open-empty-btn">Open blank workspace →</span>
            <span style="color:var(--fg-muted);font-size:12px;">Zero auth required</span>
          </div>
        </form>
      </div>
    </div>

    <!-- Fullscreen CodeLab Workbench Mount -->
    <div id="codelab-mount"></div>
  </main>

  <script is:inline>
    (function () {
      const mountEl = document.getElementById('codelab-mount');
      const landingOverlay = document.getElementById('landing-overlay');
      const landingForm = document.getElementById('landing-form');
      const repoInput = document.getElementById('landing-repo-input');
      const cloneBtn = document.getElementById('landing-clone-btn');
      const progressBox = document.getElementById('progress-box');
      const openEmptyBtn = document.getElementById('open-empty-btn');
      const openCloneModalBtn = document.getElementById('open-clone-modal-btn');
      const brandHomeBtn = document.getElementById('brand-home-btn');
      const themeBtn = document.getElementById('theme-btn');
      const iconSun = document.getElementById('theme-icon-sun');
      const iconMoon = document.getElementById('theme-icon-moon');

      let ideInstance = null;

      function logProgress(phase, message) {
        progressBox.classList.add('active');
        const line = document.createElement('div');
        line.className = 'progress-line ' + (phase || '');
        const time = new Date().toLocaleTimeString();
        line.textContent = `[${time}] ${message}`;
        progressBox.appendChild(line);
        progressBox.scrollTop = progressBox.scrollHeight;
      }

      function ensureIde(options = {}) {
        if (!ideInstance && window.CodeLab) {
          ideInstance = window.CodeLab.mount(mountEl, {
            title: 'code-lab',
            theme: document.documentElement.getAttribute('data-theme') || 'dark',
            files: options.files || {
              'README.md': '# Welcome to code-lab\n\nUse the interactive terminal below or run `git clone <owner/repo>` to explore any public repository.\n'
            },
            entry: 'demo.js',
            ...options
          });
        }
        return ideInstance;
      }

      async function executeClone(targetRepo) {
        if (!targetRepo) return;
        cloneBtn.disabled = true;
        progressBox.innerHTML = '';
        logProgress('connecting', `Connecting to GitHub for repository: ${targetRepo}...`);

        try {
          const ide = ensureIde();
          if (!ide) {
            throw new Error('CodeLab SDK failed to initialize');
          }

          logProgress('metadata', 'Fetching repository tree and default branch metadata...');

          const cloneFn = (typeof ide.cloneRepo === 'function') 
            ? ide.cloneRepo.bind(ide) 
            : (window.CodeLab && typeof window.CodeLab.cloneRepo === 'function')
              ? ((r, opts) => window.CodeLab.cloneRepo(r, ide.shell ? ide.shell.vfs : null, opts))
              : null;

          if (!cloneFn) {
            throw new Error('cloneRepo is not supported in this build');
          }

          logProgress('downloading', 'Downloading source files into virtual filesystem...');

          const result = await cloneFn(targetRepo, {
            intoRoot: true,
            onProgress: (evt) => {
              if (evt && evt.message) {
                logProgress(evt.phase || 'downloading', evt.message);
              }
            }
          });

          const count = result.filesWritten || (result.files && Object.keys(result.files).length) || 0;
          logProgress('mounting', `Synchronizing ${count} files into Monaco editor & explorer...`);
          logProgress('ready', `✓ Cloned ${result.owner || ''}/${result.repo || targetRepo}@${result.branch || 'main'} successfully!`);

          // Update URL without full reload
          const url = new URL(window.location.href);
          url.searchParams.set('repo', targetRepo);
          window.history.replaceState({}, '', url.toString());

          // Transition to full IDE
          setTimeout(() => {
            landingOverlay.classList.add('hidden');
          }, 450);

        } catch (err) {
          logProgress('error', `Error: ${err.message || err}`);
        } finally {
          cloneBtn.disabled = false;
        }
      }

      landingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = repoInput.value.trim();
        if (val) executeClone(val);
      });

      openEmptyBtn.addEventListener('click', () => {
        ensureIde();
        landingOverlay.classList.add('hidden');
      });

      openCloneModalBtn.addEventListener('click', () => {
        landingOverlay.classList.remove('hidden');
        progressBox.classList.remove('active');
        progressBox.innerHTML = '';
        repoInput.focus();
        repoInput.select();
      });

      brandHomeBtn.addEventListener('click', () => {
        landingOverlay.classList.remove('hidden');
      });

      // Theme toggle
      function updateThemeIcons(theme) {
        if (theme === 'light') {
          iconSun.style.display = 'block';
          iconMoon.style.display = 'none';
        } else {
          iconSun.style.display = 'none';
          iconMoon.style.display = 'block';
        }
      }

      themeBtn.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        updateThemeIcons(next);
        if (ideInstance && typeof ideInstance.setTheme === 'function') {
          ideInstance.setTheme(next);
        }
      });

      // Auto-clone if URL has ?repo=
      const initialParams = new URLSearchParams(window.location.search);
      const urlRepo = initialParams.get('repo');
      if (urlRepo) {
        repoInput.value = urlRepo;
        executeClone(urlRepo);
      }
    })();
  </script>
</body>
</html>
