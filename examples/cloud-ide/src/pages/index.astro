---
// code-lab Cloud IDE — System Design In-Depth Aesthetic Alignment
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>code-lab — Browser IDE & GitHub Repository Explorer</title>
  <meta name="description" content="Clone and run any public GitHub repository directly in your browser with zero server setup. Powered by code-lab.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <link rel="stylesheet" href="/dist/code-lab.css">
  <script is:inline src="/dist/code-lab.js"></script>

  <style is:global>
    @font-face {
      font-family: "Geist";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/geist-latin.woff2") format("woff2");
    }
    @font-face {
      font-family: "Geist Mono";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/geist-mono-latin.woff2") format("woff2");
    }

    /* ═══════════════════════════════════════════════════════════════
       Ved Gupta Monochrome Neutral Design Tokens (matches system-design)
       ═══════════════════════════════════════════════════════════════ */
    :root,
    [data-theme="dark"] {
      --bg: #000000;
      --bg-alt: #0a0a0a;
      --surface: #0a0a0a;
      --surface-hover: #171717;
      --surface-active: #262626;
      --border: #262626;
      --border-strong: #404040;
      --border-focus: #737373;
      --divider: #171717;

      --fg: #ffffff;
      --fg-prose: #e5e5e5;
      --fg-muted: #a1a1a1;
      --fg-faint: #8f8f8f;

      --accent: #ffffff;
      --accent-hover: #e5e5e5;
      --accent-muted: rgba(255, 255, 255, 0.08);
      --accent-border: rgba(255, 255, 255, 0.22);
      --accent-fg: #000000;

      --success: #05df72;
      --success-muted: rgba(5, 223, 114, 0.12);
      --warning: #ffd236;
      --warning-muted: rgba(255, 210, 54, 0.12);
      --error: #fb2c36;
      --error-muted: rgba(251, 44, 54, 0.12);
      --info: #54a2ff;
      --info-muted: rgba(84, 162, 255, 0.12);

      --r-sm: 4px;
      --r-md: 6px;
      --r-lg: 8px;
      --r-xl: 12px;
      --r-full: 999px;

      --font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, "Roboto Mono", Menlo, monospace;
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #ffffff;
      --bg-alt: #fafafa;
      --surface: #ffffff;
      --surface-hover: #f5f5f5;
      --surface-active: #e5e5e5;
      --border: #e5e5e5;
      --border-strong: #d4d4d4;
      --border-focus: #a1a1a1;
      --divider: #f0f0f0;

      --fg: #000000;
      --fg-prose: #171717;
      --fg-muted: #737373;
      --fg-faint: #a1a1a1;

      --accent: #000000;
      --accent-hover: #262626;
      --accent-muted: rgba(0, 0, 0, 0.06);
      --accent-border: rgba(0, 0, 0, 0.15);
      --accent-fg: #ffffff;

      --success: #05df72;
      --success-muted: rgba(5, 223, 114, 0.12);
      --warning: #f59e0b;
      --warning-muted: rgba(245, 158, 11, 0.12);
      --error: #e11d48;
      --error-muted: rgba(225, 29, 72, 0.12);
      --info: #2563eb;
      --info-muted: rgba(37, 99, 235, 0.12);

      color-scheme: light;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-sans);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ═══════════════════════════════════════════════════════════════
       Top Navigation Bar (52px matching system-design --topbar-h)
       ═══════════════════════════════════════════════════════════════ */
    .app-header {
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
      z-index: 30;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: -0.03em;
      cursor: pointer;
      color: var(--fg);
      text-decoration: none;
      user-select: none;
    }

    .brand-logo-badge {
      width: 24px;
      height: 24px;
      border-radius: var(--r-sm);
      background: var(--surface-hover);
      border: 1px solid var(--border-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--fg);
    }

    .brand-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 8px;
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--fg-muted);
      border: 1px solid var(--border);
      border-radius: var(--r-full);
      background: var(--surface);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 2px var(--success-muted);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-family: var(--font-sans);
      font-weight: 500;
      padding: 0 10px;
      height: 28px;
      border-radius: var(--r-md);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--fg-muted);
      cursor: pointer;
      text-decoration: none;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
    }

    .action-btn:hover {
      color: var(--fg);
      background: var(--surface-hover);
      border-color: var(--border-strong);
    }

    .icon-btn {
      width: 28px;
      height: 28px;
      padding: 0;
      border-radius: var(--r-md);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--fg-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
      text-decoration: none;
    }

    .icon-btn:hover {
      color: var(--fg);
      background: var(--surface-hover);
      border-color: var(--border-strong);
    }

    /* ═══════════════════════════════════════════════════════════════
       Main Viewport & Landing Screen
       ═══════════════════════════════════════════════════════════════ */
    .app-main {
      flex: 1;
      position: relative;
      display: flex;
      height: calc(100vh - 52px);
    }

    .landing-overlay {
      position: absolute;
      inset: 0;
      background: var(--bg);
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
      overflow-y: auto;
    }

    /* Subtle grid + top glow background inspired by system-design hero */
    .landing-overlay::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 50% 0%, var(--accent-muted), transparent 70%),
        linear-gradient(var(--divider) 1px, transparent 1px) 0 0 / 48px 48px,
        linear-gradient(90deg, var(--divider) 1px, transparent 1px) 0 0 / 48px 48px;
      mask-image: radial-gradient(ellipse 75% 65% at 50% 30%, #000 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 30%, #000 40%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }

    .landing-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .landing-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      padding: 32px;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), 0 16px 48px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .landing-header {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .landing-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      padding: 3px 10px;
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--fg-muted);
      border: 1px solid var(--border);
      border-radius: var(--r-full);
      background: var(--surface-hover);
    }

    .landing-title {
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1.15;
      color: var(--fg);
    }

    .landing-desc {
      font-size: 13px;
      color: var(--fg-muted);
      line-height: 1.55;
    }

    .repo-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .input-row {
      display: flex;
      gap: 8px;
    }

    .repo-input-wrapper {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .repo-input {
      width: 100%;
      height: 40px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 0 12px;
      font-size: 13px;
      font-family: var(--font-mono);
      color: var(--fg);
      outline: none;
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .repo-input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 1px var(--border-focus);
    }

    .submit-btn {
      height: 40px;
      padding: 0 16px;
      background: var(--accent);
      color: var(--accent-fg);
      border: 1px solid var(--accent);
      border-radius: var(--r-md);
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font-sans);
      letter-spacing: -0.01em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 140ms ease, opacity 140ms ease;
      white-space: nowrap;
    }

    .submit-btn:hover:not(:disabled) {
      background: var(--accent-hover);
    }

    .submit-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Preset Quick-Clone Chips */
    .chip-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .chip-label {
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--fg-faint);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .chip-item {
      font-size: 11px;
      font-family: var(--font-mono);
      padding: 3px 8px;
      background: var(--surface-hover);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
      user-select: none;
    }

    .chip-item:hover {
      color: var(--fg);
      background: var(--surface-active);
      border-color: var(--border-strong);
    }

    /* Streaming Clone Progress Box */
    .progress-box {
      display: none;
      flex-direction: column;
      gap: 6px;
      padding: 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.45;
      max-height: 160px;
      overflow-y: auto;
    }

    .progress-box.active {
      display: flex;
    }

    .progress-line {
      display: flex;
      align-items: baseline;
      gap: 8px;
      color: var(--fg-muted);
    }

    .progress-line .time {
      color: var(--fg-faint);
      font-size: 10px;
      flex-shrink: 0;
    }

    .progress-line.connecting { color: var(--info); }
    .progress-line.metadata { color: #a78bfa; }
    .progress-line.downloading { color: #38bdf8; }
    .progress-line.mounting { color: var(--warning); }
    .progress-line.ready { color: var(--success); font-weight: 500; }
    .progress-line.error { color: var(--error); font-weight: 500; }

    .alt-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      padding-top: 4px;
      border-top: 1px solid var(--divider);
    }

    .alt-link {
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 120ms ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .alt-link:hover {
      color: var(--fg);
    }

    /* Fullscreen IDE Mount */
    #codelab-mount {
      width: 100%;
      height: 100%;
      flex: 1;
    }

    #codelab-mount .codelab {
      height: 100%;
      border-radius: 0;
      border: none;
    }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <header class="app-header">
    <div class="brand-section">
      <div class="app-brand" id="brand-home-btn" title="code-lab">
        <div class="brand-logo-badge">&lt;/&gt;</div>
        <span>code-lab</span>
      </div>
      <div class="brand-status-pill">
        <span class="status-dot"></span>
        <span>browser runtime</span>
      </div>
    </div>

    <div class="header-actions">
      <button type="button" class="action-btn" id="open-clone-modal-btn" title="Clone another repository">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Clone Repo</span>
      </button>

      <button type="button" class="action-btn" id="header-blank-btn" title="Open blank workspace">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>Blank IDE</span>
      </button>

      <button type="button" class="action-btn" id="header-search-btn" title="Search & Replace Across Files">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Search</span>
      </button>

      <button type="button" class="action-btn" id="header-scm-btn" title="Source Control (Git Status, Stage, Commit)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/></svg>
        <span>Source Control</span>
      </button>

      <button type="button" class="action-btn" id="header-zip-btn" title="Export Project as ZIP">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Export ZIP</span>
      </button>

      <!-- Theme Button: Icon-Only (Sun / Moon) -->
      <button type="button" class="icon-btn" id="theme-btn" title="Toggle Theme" aria-label="Toggle Theme">
        <svg id="theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>

      <!-- Docs Wiki Link -->
      <a class="icon-btn" href="https://github.com/innovatorved/code-lab/wiki" target="_blank" rel="noopener noreferrer" title="Documentation Wiki" aria-label="Wiki">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </a>

      <!-- GitHub Repository Link -->
      <a class="icon-btn" href="https://github.com/innovatorved/code-lab" target="_blank" rel="noopener noreferrer" title="GitHub Repository" aria-label="GitHub">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </a>
    </div>
  </header>

  <!-- App Main Workspace -->
  <main class="app-main">
    <!-- Initial Landing View: Repo Input & Live Progress Box -->
    <div class="landing-overlay" id="landing-overlay">
      <div class="landing-card">
        <div class="landing-header">
          <div class="landing-eyebrow">
            <span class="status-dot"></span>
            <span>zero-install client-side ide</span>
          </div>
          <h1 class="landing-title">Clone &amp; Explore GitHub Repositories</h1>
          <p class="landing-desc">
            Enter any public GitHub repository to clone and explore directly in your browser. Powered by Node.js v22 and Bun v1.1 virtual Web Worker runtime with zero server dependencies.
          </p>
        </div>

        <form class="repo-form" id="landing-form">
          <div class="input-row">
            <div class="repo-input-wrapper">
              <input
                type="text"
                id="landing-repo-input"
                class="repo-input"
                placeholder="e.g. mdn/todo-react or github.com/owner/repo"
                value="mdn/todo-react"
                spellcheck="false"
                autocomplete="off"
              />
            </div>
            <button type="submit" class="submit-btn" id="landing-clone-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Clone &amp; Open</span>
            </button>
          </div>

          <!-- Suggested Repositories Chips -->
          <div class="chip-container">
            <div class="chip-label">Featured Runnable Repositories &amp; System Design Clusters</div>
            <div class="chip-list">
              <span class="chip-item chip-item--demo" data-demo="sd-cluster">⚡ L7 Load Balancer &amp; Chaos Cluster</span>
              <span class="chip-item chip-item--demo" data-demo="sd-shortener">🔗 URL Shortener · SQLite + Singleflight</span>
              <span class="chip-item chip-item--demo" data-demo="react">⚛ React App · live preview</span>
              <span class="chip-item" data-repo="mdn/todo-react">mdn/todo-react</span>
              <span class="chip-item" data-repo="ahfarmer/calculator">ahfarmer/calculator</span>
              <span class="chip-item" data-repo="gabrielecirulli/2048">gabrielecirulli/2048</span>
              <span class="chip-item" data-repo="innovatorved/piano-web">innovatorved/piano-web</span>
            </div>
          </div>

          <!-- Streaming Logs Box -->
          <div class="progress-box" id="progress-box"></div>

          <div class="alt-actions">
            <span class="alt-link" id="open-empty-btn">Open blank workspace &rarr;</span>
            <span style="color:var(--fg-faint);font-size:11px;font-family:var(--font-mono);">Zero auth required</span>
          </div>
        </form>
      </div>
    </div>

    <!-- Fullscreen CodeLab Workbench Mount -->
    <div id="codelab-mount"></div>
  </main>

  <script is:inline>
    (function () {
      const mountEl = document.getElementById('codelab-mount');
      const landingOverlay = document.getElementById('landing-overlay');
      const landingForm = document.getElementById('landing-form');
      const repoInput = document.getElementById('landing-repo-input');
      const cloneBtn = document.getElementById('landing-clone-btn');
      const progressBox = document.getElementById('progress-box');
      const openEmptyBtn = document.getElementById('open-empty-btn');
      const headerBlankBtn = document.getElementById('header-blank-btn');
      const openCloneModalBtn = document.getElementById('open-clone-modal-btn');
      const brandHomeBtn = document.getElementById('brand-home-btn');
      const themeBtn = document.getElementById('theme-btn');
      const iconSun = document.getElementById('theme-icon-sun');
      const iconMoon = document.getElementById('theme-icon-moon');
      const chipItems = document.querySelectorAll('.chip-item');

      let ideInstance = null;

      function logProgress(phase, message) {
        progressBox.classList.add('active');
        const line = document.createElement('div');
        line.className = 'progress-line ' + (phase || '');
        const time = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
        line.innerHTML = `<span class="time">[${time}]</span><span>${message}</span>`;
        progressBox.appendChild(line);
        progressBox.scrollTop = progressBox.scrollHeight;
      }

      const SESSION_STORAGE_KEY = 'codelab:cloud-ide:session';

      function saveSessionMeta(meta) {
        try {
          localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({ ...meta, updatedAt: Date.now() }));
        } catch (_) {}
      }

      function loadSessionMeta() {
        try {
          const raw = localStorage.getItem(SESSION_STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_) {
          return null;
        }
      }

      function hasSavedFilesForLab(labId) {
        try {
          const raw = localStorage.getItem('sd-codelab-v1:' + labId)
            || localStorage.getItem('sd_codelab_' + labId)
            || localStorage.getItem('codelab_' + labId);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          return Boolean(parsed && parsed.customFiles && Object.keys(parsed.customFiles).length > 0);
        } catch (_) {
          return false;
        }
      }

      function ensureIde(options = {}) {
        const targetLabId = options.labId || 'cloud-ide';
        if (ideInstance && ideInstance.labId !== targetLabId) {
          if (typeof ideInstance.destroy === 'function') ideInstance.destroy();
          mountEl.innerHTML = '';
          ideInstance = null;
        }
        if (!ideInstance && window.CodeLab) {
          ideInstance = window.CodeLab.mount(mountEl, {
            labId: targetLabId,
            title: 'code-lab',
            theme: document.documentElement.getAttribute('data-theme') || 'dark',
            files: options.files || {
              'README.md': '# Welcome to code-lab\n\nUse the interactive terminal below or run `git clone <owner/repo>` to explore any public repository.\n'
            },
            entry: 'demo.js',
            ...options
          });
        }
        // Exposed for the demo console and for end-to-end tests that need the
        // live instance.
        window.__codelabIde = ideInstance;
        return ideInstance;
      }

      async function executeClone(targetRepo, options = {}) {
        if (!targetRepo) return;
        const labId = 'repo-' + targetRepo.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase();
        if (!options.forceClone && hasSavedFilesForLab(labId)) {
          const ide = ensureIde({ labId });
          saveSessionMeta({ mode: 'repo', repo: targetRepo, labId });
          landingOverlay.classList.add('hidden');
          if (ide) {
            setTimeout(() => {
              const ed = ide._editor || ide.editor;
              if (ed && typeof ed.layout === 'function') ed.layout();
              if (typeof ide.previewApp === 'function' && ide.files && (ide.files['index.html'] || ide.files['public/index.html'])) {
                ide.previewApp();
              }
            }, 60);
          }
          return;
        }

        cloneBtn.disabled = true;
        progressBox.innerHTML = '';
        logProgress('connecting', `Connecting to GitHub API for ${targetRepo}...`);

        try {
          const ide = ensureIde({ labId });
          if (!ide) {
            throw new Error('CodeLab SDK failed to initialize');
          }

          logProgress('metadata', 'Fetching repository tree and metadata...');

          const cloneFn = (typeof ide.cloneRepo === 'function') 
            ? ide.cloneRepo.bind(ide) 
            : (window.CodeLab && typeof window.CodeLab.cloneRepo === 'function')
              ? ((r, opts) => window.CodeLab.cloneRepo(r, ide.shell ? ide.shell.vfs : null, opts))
              : null;

          if (!cloneFn) {
            throw new Error('cloneRepo is not supported in this build');
          }

          logProgress('downloading', 'Downloading source files into virtual filesystem...');

          const result = await cloneFn(targetRepo, {
            intoRoot: true,
            onProgress: (evt) => {
              if (evt && evt.message) {
                logProgress(evt.phase || 'downloading', evt.message);
              }
            }
          });

          const count = result.filesWritten || (result.files && Object.keys(result.files).length) || 0;
          logProgress('mounting', `Synchronizing ${count} files into Monaco editor & explorer...`);
          logProgress('ready', `✓ Cloned ${result.owner || ''}/${result.repo || targetRepo}@${result.branch || 'main'} successfully!`);

          // Update URL without full reload
          const url = new URL(window.location.href);
          url.searchParams.delete('demo');
          url.searchParams.set('repo', targetRepo);
          window.history.replaceState({}, '', url.toString());
          saveSessionMeta({ mode: 'repo', repo: targetRepo, labId });

          // Transition to full IDE
          setTimeout(() => {
            landingOverlay.classList.add('hidden');
            if (ide) {
              const ed = ide._editor || ide.editor;
              if (ed && typeof ed.layout === 'function') ed.layout();
              if (typeof ide.previewApp === 'function' && ide.files && (ide.files['index.html'] || ide.files['public/index.html'])) {
                ide.previewApp();
              }
            }
          }, 350);

        } catch (err) {
          logProgress('error', `Error: ${err.message || err}`);
        } finally {
          cloneBtn.disabled = false;
        }
      }

      landingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = repoInput.value.trim();
        if (val) executeClone(val, { forceClone: true });
      });

      chipItems.forEach(chip => {
        chip.addEventListener('click', () => {
          const demoKind = chip.getAttribute('data-demo');
          if (demoKind === 'react') {
            openFrameworkDemo({ forceReset: false });
            return;
          }
          if (demoKind === 'sd-cluster' || demoKind === 'sd-shortener') {
            openSystemDesignDemo(demoKind, { forceReset: false });
            return;
          }
          const repo = chip.getAttribute('data-repo');
          if (repo) {
            repoInput.value = repo;
            executeClone(repo, { forceClone: false });
          }
        });
      });

      const SD_CLUSTER_DEMO_FILES = {
        'README.md': '# L7 Load Balancer + 3-Worker Cluster + Chaos Failover\n\nA runnable multi-node System Design cluster running entirely in your browser.\n\n## Quick Start\n1. Press **Run** (or run `node cluster.js &` in the terminal) to boot:\n   - **L7 Load Balancer** on `:3000` (Round-Robin + Retry with Jitter + Circuit Breaker)\n   - **Worker Nodes** on `:3001`, `:3002`, and `:3003`\n2. Run a load test in the terminal:\n   ```bash\n   hey -n 60 -c 10 http://localhost:3000/api/orders\n   ```\n3. Open the **Ports** or **Network** tab to view the live **Service Topology**, **SLO Telemetry Bar (p50/p95/p99)**, and inject faults using the **Chaos Controls** (or CLI):\n   ```bash\n   chaos crash 3002\n   chaos latency 3001 180 --jitter 40\n   hey -n 40 -c 8 http://localhost:3000/api/orders\n   chaos reset\n   ```\n',
        'worker.js': 'const http = require("node:http");\n\nfunction startWorker(port, region) {\n  let reqCount = 0;\n  const server = http.createServer((req, res) => {\n    reqCount++;\n    if (req.url === "/health") {\n      res.writeHead(200, { "Content-Type": "application/json" });\n      return res.end(JSON.stringify({ status: "healthy", port, region, reqCount }));\n    }\n    res.writeHead(200, {\n      "Content-Type": "application/json",\n      "X-Worker-Port": String(port),\n      "X-Worker-Region": region\n    });\n    res.end(JSON.stringify({\n      ok: true,\n      worker: `node-${port}`,\n      region,\n      seq: reqCount,\n      path: req.url\n    }));\n  });\n  server.listen(port, () => {\n    console.log(`[Worker :${port}] Ready in ${region}`);\n  });\n  return server;\n}\n\nmodule.exports = { startWorker };\n',
        'lb.js': 'const http = require("node:http");\n\nfunction startLoadBalancer(port, upstreams) {\n  let rrIndex = 0;\n  const stats = { total: 0, retries: 0, byWorker: {} };\n\n  function forwardToWorker(workerPort, path) {\n    return new Promise((resolve, reject) => {\n      const req = http.request({ hostname: "localhost", port: workerPort, path, method: "GET" }, (res) => {\n        let body = "";\n        res.on("data", (chunk) => { body += chunk; });\n        res.on("end", () => resolve({ statusCode: res.statusCode || 200, headers: res.headers, body, workerPort }));\n      });\n      req.on("error", reject);\n      req.end();\n    });\n  }\n\n  const server = http.createServer(async (req, res) => {\n    stats.total++;\n    if (req.url === "/stats") {\n      res.writeHead(200, { "Content-Type": "application/json" });\n      return res.end(JSON.stringify(stats, null, 2));\n    }\n\n    let lastErr = null;\n    for (let attempt = 0; attempt < upstreams.length; attempt++) {\n      const targetPort = upstreams[(rrIndex++) % upstreams.length];\n      try {\n        const upstreamRes = await forwardToWorker(targetPort, req.url);\n        if (upstreamRes.statusCode >= 500) {\n          stats.retries++;\n          lastErr = new Error(`Upstream :${targetPort} returned HTTP ${upstreamRes.statusCode}`);\n          continue;\n        }\n        stats.byWorker[targetPort] = (stats.byWorker[targetPort] || 0) + 1;\n        res.writeHead(upstreamRes.statusCode, {\n          "Content-Type": "application/json",\n          "X-Routed-To": String(targetPort),\n          "X-Attempts": String(attempt + 1)\n        });\n        return res.end(upstreamRes.body);\n      } catch (err) {\n        stats.retries++;\n        lastErr = err;\n      }\n    }\n\n    res.writeHead(503, { "Content-Type": "application/json" });\n    res.end(JSON.stringify({ error: "All upstream workers unavailable", detail: lastErr ? lastErr.message : "unknown" }));\n  });\n\n  server.listen(port, () => {\n    console.log(`[L7 Load Balancer :${port}] Balancing across -> ${upstreams.map(p => ":" + p).join(", ")}`);\n  });\n  return server;\n}\n\nmodule.exports = { startLoadBalancer };\n',
        'cluster.js': 'const http = require("node:http");\nconst { startWorker } = require("./worker");\nconst { startLoadBalancer } = require("./lb");\n\nconst WORKER_PORTS = [3001, 3002, 3003];\nstartWorker(3001, "us-east-1a");\nstartWorker(3002, "us-east-1b");\nstartWorker(3003, "us-east-1c");\nstartLoadBalancer(3000, WORKER_PORTS);\n\nsetTimeout(async () => {\n  console.log("\\n--- Sending 6 warmup requests through L7 Load Balancer (:3000) ---");\n  for (let i = 0; i < 6; i++) {\n    await new Promise((resolve) => {\n      http.get("http://localhost:3000/api/orders", (res) => {\n        let data = "";\n        res.on("data", c => data += c);\n        res.on("end", () => {\n          console.log(`Req #${i + 1} [${res.statusCode}] routed->:${res.headers["x-routed-to"]} ${data}`);\n          resolve();\n        });\n      }).on("error", (e) => { console.error(e.message); resolve(); });\n    });\n  }\n  console.log("\\nCluster is live on :3000 -> [:3001, :3002, :3003]!");\n  console.log("Try in Terminal: hey -n 50 -c 10 http://localhost:3000/api/orders");\n  console.log("Try Chaos CLI : chaos crash 3002 && hey -n 30 -c 6 http://localhost:3000/api/orders");\n}, 80);\n'
      };

      const SD_SHORTENER_DEMO_FILES = {
        'README.md': '# High-Throughput URL Shortener (Cache-Aside + Singleflight + SQLite)\n\nDemonstrates how production read-heavy systems protect their database from **Cache Stampedes (Thundering Herd)** using **In-Memory Cache-Aside + Singleflight Request Coalescing** backed by **SQLite**.\n\n## Quick Start\n1. Press **Run** (or `bun run server.js &`) to start the service on `:3000` and seed `urls.db`.\n2. Inspect the SQLite database directly from the terminal:\n   ```bash\n   sqlite3 urls.db \"SELECT * FROM urls\"\n   sqlite3 urls.db \"EXPLAIN QUERY PLAN SELECT target FROM urls WHERE code = \'sd-book\'\"\n   ```\n3. Benchmark latency & cache hit rate under concurrency:\n   ```bash\n   hey -n 80 -c 16 http://localhost:3000/r/sd-book\n   curl http://localhost:3000/metrics\n   ```\n',
        'server.js': 'const http = require("node:http");\nconst { Database } = require("bun:sqlite");\n\nconst db = new Database("urls.db");\ndb.exec("CREATE TABLE IF NOT EXISTS urls (code TEXT PRIMARY KEY, target TEXT, hits INTEGER DEFAULT 0)");\ndb.exec("CREATE INDEX IF NOT EXISTS idx_urls_code ON urls (code)");\ndb.exec("INSERT OR REPLACE INTO urls (code, target, hits) VALUES (\'sd-book\', \'https://system-design-in-depth.vedgupta.in\', 0), (\'codelab\', \'https://code-lab-3dr.pages.dev\', 0)");\n\nconst cache = new Map();\nconst inflight = new Map();\nconst metrics = { totalRequests: 0, cacheHits: 0, singleflightCoalesced: 0, dbQueries: 0 };\n\nfunction queryDbWithSimulatedLatency(code) {\n  metrics.dbQueries++;\n  return new Promise((resolve) => {\n    setTimeout(() => {\n      const row = db.query("SELECT code, target, hits FROM urls WHERE code = ?").get(code);\n      resolve(row || null);\n    }, 25);\n  });\n}\n\nasync function resolveCode(code) {\n  const cached = cache.get(code);\n  if (cached && cached.expiresAt > Date.now()) {\n    metrics.cacheHits++;\n    return { row: cached.row, source: "cache" };\n  }\n  if (inflight.has(code)) {\n    metrics.singleflightCoalesced++;\n    const row = await inflight.get(code);\n    return { row, source: "singleflight" };\n  }\n  const p = queryDbWithSimulatedLatency(code).then((row) => {\n    inflight.delete(code);\n    if (row) cache.set(code, { row, expiresAt: Date.now() + 15000 });\n    return row;\n  });\n  inflight.set(code, p);\n  const row = await p;\n  return { row, source: "db" };\n}\n\nconst server = http.createServer(async (req, res) => {\n  metrics.totalRequests++;\n  if (req.url === "/metrics") {\n    res.writeHead(200, { "Content-Type": "application/json" });\n    return res.end(JSON.stringify(metrics, null, 2));\n  }\n  if (req.url.startsWith("/r/")) {\n    const code = req.url.slice(3).split("?")[0];\n    const { row, source } = await resolveCode(code);\n    if (!row) {\n      res.writeHead(404, { "Content-Type": "application/json" });\n      return res.end(JSON.stringify({ error: "Not found", code }));\n    }\n    res.writeHead(200, { "Content-Type": "application/json", "X-Cache-Source": source });\n    return res.end(JSON.stringify({ code: row.code, target: row.target, source }));\n  }\n  res.writeHead(200, { "Content-Type": "application/json" });\n  res.end(JSON.stringify({ service: "url-shortener", endpoints: ["/r/sd-book", "/r/codelab", "/metrics"] }));\n});\n\nserver.listen(3000, async () => {\n  console.log("[URL Shortener :3000] Ready with SQLite + Cache-Aside + Singleflight");\n  // Fire 10 concurrent cold requests to prove Singleflight coalesces 10 -> 1 DB query\n  await Promise.all(Array.from({ length: 10 }, () => new Promise((r) => {\n    http.get("http://localhost:3000/r/sd-book", (res) => { res.resume(); res.on("end", r); }).on("error", r);\n  })));\n  console.log("10 concurrent cold requests finished! Metrics:", JSON.stringify(metrics));\n  console.log("Notice dbQueries === 1 and singleflightCoalesced === 9 (Zero Cache Stampede!)");\n});\n'
      };

      function openSystemDesignDemo(kind, opts = {}) {
        const isShortener = kind === 'sd-shortener';
        const labId = isShortener ? 'sd-shortener-demo' : 'sd-cluster-demo';
        const demoFiles = isShortener ? SD_SHORTENER_DEMO_FILES : SD_CLUSTER_DEMO_FILES;
        const entryFile = isShortener ? 'server.js' : 'cluster.js';
        const hadSaved = hasSavedFilesForLab(labId);
        const ide = ensureIde({ labId, files: demoFiles, entry: entryFile });
        landingOverlay.classList.add('hidden');
        if (opts.forceReset && ide && typeof ide.setFiles === 'function') {
          ide.setFiles(demoFiles);
        } else if (!hadSaved && ide && typeof ide.setFiles === 'function' && (!ide.files || !ide.files[entryFile])) {
          ide.setFiles(demoFiles);
        }
        const url = new URL(window.location.href);
        url.searchParams.delete('repo');
        url.searchParams.set('demo', kind);
        window.history.replaceState({}, '', url.toString());
        saveSessionMeta({ mode: 'demo', demo: kind, labId });
        setTimeout(() => {
          const ed = ide && (ide._editor || ide.editor);
          if (ed && typeof ed.layout === 'function') ed.layout();
          if (ide && typeof ide.openFile === 'function') ide.openFile(entryFile);
          if (ide && typeof ide.runProject === 'function') ide.runProject();
        }, 150);
      }

      // A ready-to-run React + TypeScript workspace. Opening it and pressing the
      // toolbar globe (Run & Preview) renders the app in the in-browser preview.
      const REACT_DEMO_FILES = {
        'README.md': '# React + TypeScript Demo\n\nPress the globe button in the toolbar (or run `serve` in the terminal) to render this app in the in-browser Web Preview.\n\nTypeScript and TSX are transpiled to browser-native ESM automatically, and bare imports resolve to jsDelivr ESM builds \u2014 no bundler required.\n',
        'index.html': '<!doctype html>\n<html lang="en">\n  <head>\n    <meta charset="utf-8" />\n    <meta name="viewport" content="width=device-width, initial-scale=1" />\n    <title>React + TypeScript \u00b7 code-lab</title>\n    <link rel="stylesheet" href="/styles.css" />\n  </head>\n  <body>\n    <div id="root"></div>\n    <script type="module" src="/main.tsx"><\/script>\n  </body>\n</html>\n',
        'styles.css': ':root { color-scheme: dark; }\nbody { margin: 0; font-family: ui-sans-serif, system-ui, sans-serif; background: #0b0e14; color: #e6e6e6; }\n.app { max-width: 520px; margin: 12vh auto; padding: 32px; border: 1px solid #263041; border-radius: 16px; background: #0f141d; }\nh1 { margin: 0 0 4px; font-size: 22px; }\np.sub { margin: 0 0 24px; color: #8b97a8; font-size: 14px; }\nbutton { font: inherit; padding: 8px 16px; border-radius: 10px; border: 1px solid #2f6feb; background: #2f6feb; color: #fff; cursor: pointer; }\nbutton.ghost { background: transparent; color: #9db2d6; border-color: #263041; }\n.count { font-size: 42px; font-weight: 700; margin: 16px 0; }\n.row { display: flex; gap: 10px; align-items: center; }\n.badge { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 999px; background: #16233a; color: #7aa2f7; margin-left: 8px; }\ninput { font: inherit; padding: 6px 10px; border-radius: 8px; border: 1px solid #263041; background: #0b0e14; color: inherit; }\n',
        'main.tsx': 'import React, { useState } from "react";\nimport { createRoot } from "react-dom/client";\nimport { Counter } from "./components/Counter";\n\nfunction App() {\n  const [name, setName] = useState("code-lab");\n  return (\n    <main className="app">\n      <h1>Hello from React<span className="badge">TSX</span></h1>\n      <p className="sub">Rendered entirely in your browser \u2014 no bundler, no server.</p>\n      <Counter initial={0} />\n      <p style={{ marginTop: 24 }}>\n        Editing <input value={name} onChange={(e) => setName(e.target.value)} />\n      </p>\n    </main>\n  );\n}\n\ncreateRoot(document.getElementById("root")!).render(<App />);\n',
        'components/Counter.tsx': 'import React, { useState } from "react";\n\nexport function Counter({ initial = 0 }: { initial?: number }) {\n  const [n, setN] = useState(initial);\n  return (\n    <div>\n      <div className="count">{n}</div>\n      <div className="row">\n        <button onClick={() => setN(n + 1)}>Increment</button>\n        <button className="ghost" onClick={() => setN(initial)}>Reset</button>\n      </div>\n    </div>\n  );\n}\n',
        'package.json': JSON.stringify({ name: 'react-tsx-demo', version: '1.0.0', private: true, dependencies: { react: '^19', 'react-dom': '^19' }, scripts: { dev: 'vite' } }, null, 2) + '\n'
      };

