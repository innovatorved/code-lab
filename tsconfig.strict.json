{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "declaration": false,
    "declarationDir": null,
    "emitDeclarationOnly": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "include": [
    "src/csp.ts",
    "src/logger.ts",
    "src/html.ts",
    "src/zip.ts",
    "src/storage.ts",
    "src/search.ts",
    "src/diagnostics.ts",
    "src/scm.ts",
    "src/schemas.ts",
    "src/modular-kernel.ts",
    "src/workbench/share.ts",
    "src/workbench/guided-pane.ts",
    "src/workbench/icons.ts",
    "packages/*/src/**/*.ts",
    "apps/web/src/**/*.ts"
  ]
}
