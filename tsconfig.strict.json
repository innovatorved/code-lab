{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "declaration": false,
    "declarationDir": null,
    "emitDeclarationOnly": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "include": [
    "src/csp.ts",
    "src/logger.ts",
    "src/html.ts",
    "src/zip.ts",
    "src/storage.ts",
    "src/search.ts",
    "src/diagnostics.ts",
    "src/scm.ts"
  ]
}
