{
  "name": "@innovatorved/code-lab",
  "version": "0.2.0",
  "description": "Standalone browser-native IDE Workbench, POSIX Shell & Coreutils, PTY Terminal, Web Worker Node.js/Bun Virtual Runtime, and Real WebAssembly C++20 (Clang/WASI) Extension.",
  "main": "./dist/code-lab.js",
  "module": "./dist/code-lab.esm.js",
  "types": "./dist/code-lab.d.ts",
  "style": "./dist/code-lab.css",
  "exports": {
    ".": {
      "types": "./dist/code-lab.d.ts",
      "import": "./dist/code-lab.esm.js",
      "require": "./dist/code-lab.js",
      "default": "./dist/code-lab.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.esm.js",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.esm.js",
      "require": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.esm.js",
      "require": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./extensions/guided-lab": {
      "types": "./dist/extensions/guided-lab.d.ts",
      "import": "./dist/extensions/guided-lab.esm.js",
      "require": "./dist/extensions/guided-lab.js",
      "default": "./dist/extensions/guided-lab.js"
    },
    "./extensions/javascript": {
      "types": "./dist/extensions/javascript.d.ts",
      "import": "./dist/extensions/javascript.esm.js",
      "require": "./dist/extensions/javascript.js",
      "default": "./dist/extensions/javascript.js"
    },
    "./extensions/typescript": {
      "types": "./dist/extensions/typescript.d.ts",
      "import": "./dist/extensions/typescript.esm.js",
      "require": "./dist/extensions/typescript.js",
      "default": "./dist/extensions/typescript.js"
    },
    "./extensions/cpp": {
      "types": "./dist/extensions/cpp.d.ts",
      "import": "./dist/extensions/cpp.esm.js",
      "require": "./dist/extensions/cpp.js",
      "default": "./dist/extensions/cpp.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.esm.js",
      "require": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./css": "./dist/code-lab.css",
    "./code-lab.css": "./dist/code-lab.css",
    "./dist/code-lab.css": "./dist/code-lab.css",
    "./sample.html": "./dist/sample.html",
    "./sample": "./dist/sample.html",
    "./preview-sw.js": "./dist/preview-sw.js",
    "./preview-sw": "./dist/preview-sw.js",
    "./sw": "./dist/preview-sw.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innovatorved/code-lab.git"
  },
  "homepage": "https://github.com/innovatorved/code-lab#readme",
  "bugs": {
    "url": "https://github.com/innovatorved/code-lab/issues"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun run tools/bundle.js",
    "lint": "node tools/lint.js",
    "typecheck": "bun x tsc --noEmit",
    "typecheck:strict": "bun x tsc -p tsconfig.strict.json",
    "test": "bun run tools/bundle.js && bun run tests/run-all.js",
    "test:all": "bun run test",
    "test:unit": "bun run tests/run-all.js --filter=test-",
    "test:e2e": "bun run tools/bundle.js && bun run tests/e2e/run-all-e2e.js",
    "test:browser": "bunx playwright test --project=chromium",
    "test:browser:all": "bunx playwright test",
    "test:browser:install": "bunx playwright install --with-deps chromium firefox webkit",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ide",
    "code-playground",
    "monaco-editor",
    "virtual-runtime",
    "web-component",
    "system-design",
    "browser-sandbox",
    "guided-labs"
  ],
  "author": "Ved Gupta",
  "license": "MIT"
}
