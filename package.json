{
  "name": "@innovatorved/code-lab",
  "version": "0.1.5",
  "description": "Standalone browser-native IDE Workbench, POSIX Shell & Coreutils, PTY Terminal, and Web Worker Node.js/Bun Virtual Runtime.",
  "main": "./dist/code-lab.js",
  "module": "./dist/code-lab.esm.js",
  "types": "./dist/code-lab.d.ts",
  "style": "./dist/code-lab.css",
  "exports": {
    ".": {
      "types": "./dist/code-lab.d.ts",
      "import": "./dist/code-lab.esm.js",
      "require": "./dist/code-lab.js",
      "default": "./dist/code-lab.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.esm.js",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.esm.js",
      "require": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.esm.js",
      "require": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./extensions/guided-lab": {
      "types": "./dist/extensions/guided-lab.d.ts",
      "import": "./dist/extensions/guided-lab.esm.js",
      "require": "./dist/extensions/guided-lab.js",
      "default": "./dist/extensions/guided-lab.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "require": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./css": "./dist/code-lab.css",
    "./code-lab.css": "./dist/code-lab.css",
    "./dist/code-lab.css": "./dist/code-lab.css",
    "./sample.html": "./dist/sample.html",
    "./sample": "./dist/sample.html",
    "./preview-sw.js": "./dist/preview-sw.js",
    "./preview-sw": "./dist/preview-sw.js",
    "./sw": "./dist/preview-sw.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innovatorved/code-lab.git"
  },
  "homepage": "https://github.com/innovatorved/code-lab#readme",
  "bugs": {
    "url": "https://github.com/innovatorved/code-lab/issues"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun run tools/bundle.js",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun run tests/test-all-builds.js",
    "test:all": "bun run tools/bundle.js && bun run tests/test-all-builds.js && bun run tests/test-runtime-advanced.js && bun run tests/test-option1-shell-bun-http.js && bun run tests/test-frameworks.js && bun run tests/test-coreutils-adversarial.js && bun run tests/test-stress-shell.js && bun run tests/test-workbench-ui.js && bun run tests/test-terminal-streaming.js && bun run tests/test-git-clone-streaming.js && bun run tests/test-m1-adversarial-challenger.js && bun run tests/test-m1-interruption-lifecycle-stress.js && bun run tests/test-gfm-markdown.js && bun run tests/test-m2-adversarial-syntax.js && bun run tests/test-m2-adversarial-interactive.js && bun run tests/test-web-preview.js && bun run tests/test-preview-sw.js",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ide",
    "code-playground",
    "monaco-editor",
    "virtual-runtime",
    "web-component",
    "system-design",
    "browser-sandbox",
    "guided-labs"
  ],
  "author": "Ved Gupta",
  "license": "MIT"
}
