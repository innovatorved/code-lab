{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@code-lab/core": ["../core/src/index.ts"],
      "@code-lab/settings": ["../settings/src/index.ts"],
      "@code-lab/commands": ["../commands/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
