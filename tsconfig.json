{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@code-lab/core": ["./packages/core/src/index.ts"],
      "@code-lab/fs": ["./packages/fs/src/index.ts"],
      "@code-lab/settings": ["./packages/settings/src/index.ts"],
      "@code-lab/commands": ["./packages/commands/src/index.ts"],
      "@code-lab/sql": ["./packages/sql/src/index.ts"],
      "@code-lab/editor": ["./packages/editor/src/index.ts"],
      "@code-lab/runtime": ["./packages/runtime/src/index.ts"],
      "@code-lab/terminal": ["./packages/terminal/src/index.ts"],
      "@code-lab/preview": ["./packages/preview/src/index.ts"],
      "@code-lab/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
